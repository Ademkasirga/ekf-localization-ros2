<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="vehicle">

  <xacro:property name="base_length" value="0.55"/>
  <xacro:property name="base_width" value="0.38"/>
  <xacro:property name="base_height" value="0.18"/>
  <xacro:property name="wheel_radius" value="0.08"/>
  <xacro:property name="wheel_width" value="0.04"/>
  <xacro:property name="wheel_y" value="0.20"/>
  <xacro:property name="wheel_x_rear" value="-0.20"/>
  <xacro:property name="wheel_x_front" value="0.20"/>
  <xacro:property name="wheel_z" value="-0.09"/>

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius + base_height / 2.0}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="blue">
        <color rgba="0.15 0.35 0.85 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="12"/>
      <inertia ixx="0.12" ixy="0" ixz="0" iyy="0.18" iyz="0" izz="0.22"/>
    </inertial>
  </link>

  <!-- IMU: kırmızı kutu, gövde merkezinde -->
  <link name="imu_link">
    <visual>
      <geometry>
        <box size="0.06 0.04 0.02"/>
      </geometry>
      <material name="red">
        <color rgba="0.9 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.06 0.04 0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 ${base_height / 2.0 + 0.02}" rpy="0 0 0"/>
  </joint>

  <!-- GPS anteni: yeşil kutu, tavan önünde -->
  <link name="gps_link">
    <visual>
      <geometry>
        <cylinder radius="0.025" length="0.04"/>
      </geometry>
      <material name="green">
        <color rgba="0.1 0.85 0.2 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.025" length="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.03"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>

  <joint name="gps_joint" type="fixed">
    <parent link="base_link"/>
    <child link="gps_link"/>
    <origin xyz="${base_length / 2.0 - 0.08} 0 ${base_height / 2.0 + 0.05}" rpy="0 0 0"/>
  </joint>

  <xacro:macro name="wheel_link" params="name">
    <link name="${name}">
      <visual>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="black">
          <color rgba="0.08 0.08 0.08 1"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.8"/>
        <inertia ixx="0.008" ixy="0" ixz="0" iyy="0.008" iyz="0" izz="0.008"/>
      </inertial>
    </link>
  </xacro:macro>

  <xacro:wheel_link name="left_rear_wheel"/>
  <xacro:wheel_link name="right_rear_wheel"/>
  <xacro:wheel_link name="left_front_wheel"/>
  <xacro:wheel_link name="right_front_wheel"/>

  <joint name="left_rear_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_rear_wheel"/>
    <origin xyz="${wheel_x_rear} ${wheel_y} ${wheel_z}" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <joint name="right_rear_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_rear_wheel"/>
    <origin xyz="${wheel_x_rear} ${-wheel_y} ${wheel_z}" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <joint name="left_front_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_front_wheel"/>
    <origin xyz="${wheel_x_front} ${wheel_y} ${wheel_z}" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <mimic joint="left_rear_wheel_joint" multiplier="1" offset="0"/>
  </joint>

  <joint name="right_front_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_front_wheel"/>
    <origin xyz="${wheel_x_front} ${-wheel_y} ${wheel_z}" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <mimic joint="right_rear_wheel_joint" multiplier="1" offset="0"/>
  </joint>

  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
    <mu1>0.9</mu1>
    <mu2>0.9</mu2>
  </gazebo>

  <gazebo reference="left_rear_wheel">
    <mu1>1.2</mu1>
    <mu2>1.2</mu2>
  </gazebo>
  <gazebo reference="right_rear_wheel">
    <mu1>1.2</mu1>
    <mu2>1.2</mu2>
  </gazebo>
  <!-- Ön tekerlekler tahrikli değil; yüksek sürtünme aracı düz çizer. Kayarak dönsün. -->
  <gazebo reference="left_front_wheel">
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
    <slip1>1.0</slip1>
    <slip2>1.0</slip2>
  </gazebo>
  <gazebo reference="right_front_wheel">
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
    <slip1>1.0</slip1>
    <slip2>1.0</slip2>
  </gazebo>

  <gazebo reference="imu_link">
    <material>Gazebo/Red</material>
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <plugin filename="libgazebo_ros_imu_sensor.so" name="imu_plugin">
        <ros>
          <remapping>~/out:=imu</remapping>
        </ros>
        <frame_name>imu_link</frame_name>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="gps_link">
    <material>Gazebo/Green</material>
  </gazebo>

  <!-- Arka tekerleklerden diff-drive (ön tekerlekler mimic ile döner) -->
  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros></ros>
      <update_rate>50</update_rate>
      <left_joint>left_rear_wheel_joint</left_joint>
      <right_joint>right_rear_wheel_joint</right_joint>
      <wheel_separation>${2 * wheel_y}</wheel_separation>
      <wheel_diameter>${2 * wheel_radius}</wheel_diameter>
      <max_wheel_torque>30</max_wheel_torque>
      <max_wheel_acceleration>2.0</max_wheel_acceleration>
      <command_topic>cmd_vel</command_topic>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin name="joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <remapping>~/out:=joint_states</remapping>
      </ros>
      <update_rate>50</update_rate>
      <joint_name>left_rear_wheel_joint</joint_name>
      <joint_name>right_rear_wheel_joint</joint_name>
      <joint_name>left_front_wheel_joint</joint_name>
      <joint_name>right_front_wheel_joint</joint_name>
    </plugin>
  </gazebo>

</robot>
