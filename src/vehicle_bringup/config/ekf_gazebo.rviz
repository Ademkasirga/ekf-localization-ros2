Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.4
      Cell Size: 0.5
      Class: rviz_default_plugins/Grid
      Name: Grid
      Reference Frame: odom
    - Class: rviz_default_plugins/TF
      Name: TF
      Show Arrows: true
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Name: RobotModel
      Visual Enabled: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 50; 255; 50
      Line Style: Lines
      Line Width: 0.04
      Name: GerçekYol
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /ground_truth/path
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 255; 220; 0
      Line Style: Lines
      Line Width: 0.06
      Name: EKF_Yolu
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /ekf/path
    - Alpha: 0.7
      Class: rviz_default_plugins/PoseWithCovariance
      Color: 255; 80; 80
      Enabled: false
      Name: GPS_Gürültülü
      Topic:
        Value: /gps/pose
    - Alpha: 1
      Class: rviz_default_plugins/Odometry
      Name: EKF_Odometry
      Topic:
        Value: /odometry/filtered
  Global Options:
    Fixed Frame: odom
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 25
      X: 0
      Y: 0
